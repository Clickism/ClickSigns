{
  "schemaVersion": 1,
  "id": "clicksigns",
  "version": "${mod_version}",
  "name": "ClickSigns",
  "description": "An innovative mod that lets you create custom highway & street signs!",
  "authors": [
    "Clickism"
  ],
  "contact": {
    "homepage": "https://clickism.de/",
    "sources": "https://github.com/Clickism/ClickSigns"
  },
  "license": "GPL-3.0",
  "icon": "assets/clicksigns/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "de.clickism.clicksigns.platform.fabric.FabricEntrypoint"
      }
    ],
    "client": [
      {
        "value": "de.clickism.clicksigns.platform.fabric.FabricEntrypoint"
      }
    ],
    "fabric-datagen": [
      {
        "value": "de.clickism.clicksigns.platform.fabric.datagen.FabricDatagenEntrypoint"
      }
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}