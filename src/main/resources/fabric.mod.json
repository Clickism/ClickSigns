{
	"schemaVersion": 1,
	"id": "clicksigns",
	"version": "${mod_version}",
	"name": "ClickSigns",
	"description": "An innovative mod that lets you create custom highway & street signs!",
	"authors": [
		"Clickism"
	],
	"contact": {
		"homepage": "https://clickism.de/",
		"sources": "https://github.com/Clickism/ClickSigns"
	},
	"license": "GPL-3.0",
	"icon": "assets/clicksigns/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "de.clickism.clicksigns.platform.fabric.FabricEntrypoint",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "de.clickism.clicksigns.platform.fabric.FabricClientEntrypoint",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "de.clickism.clicksigns.platform.fabric.datagen.FabricDataGeneratorEntrypoint",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}